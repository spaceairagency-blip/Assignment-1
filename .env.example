SECRET_KEY=django-insecure-change-this-in-production-please
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Set USE_SQLITE=True to use SQLite (good for quick local testing/grading).
# Set USE_SQLITE=False to use PostgreSQL with the settings below.
USE_SQLITE=True

